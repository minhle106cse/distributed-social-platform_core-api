generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  // partialIndexes: cho phép `@@unique([...], where: {...})` — dùng cho
  // unique chỉ-trên-bản-chưa-xóa (soft-delete reuse). Xem model Organization.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// TENANT CONTEXT
// ─────────────────────────────────────────────

model Organization {
  id                String    @id @default(uuid(7))
  name              String
  slug              String
  seatLimit         Int       @default(10)     @map("seat_limit")
  createdAt         DateTime  @default(now())  @map("created_at")
  deletedAt         DateTime?                  @map("deleted_at")

  spaces          Space[]
  memberships     Membership[]
  rolePermissions OrgRolePermission[]
  invites         OrgInvite[]

  // Slug unique CHỈ trong các org chưa xóa-mềm (partial index, Postgres
  // `WHERE deleted_at IS NULL`). Org đã xóa nhả lại slug để tái dùng, và khớp
  // với app-check (findBySlug chỉ nhìn bản live). Thay cho `@unique` full.
  @@unique([slug], where: { deletedAt: null })
  @@map("organizations")
}

model Membership {
  id       String   @id @default(uuid(7))
  orgId    String   @map("org_id")
  userId   String   @map("user_id")   // loose ref to auth_db — no cross-db FK
  role     OrgRole  @default(MEMBER)
  joinedAt DateTime @default(now())   @map("joined_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, userId])
  @@index([orgId])
  @@map("memberships")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
  GUEST
}

model Space {
  id         String          @id @default(uuid(7))
  orgId      String          @map("org_id")
  name       String
  visibility SpaceVisibility @default(ORG)
  deletedAt  DateTime?       @map("deleted_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("spaces")
}

enum SpaceVisibility {
  ORG
  PRIVATE
}

/// Dynamic Org RBAC: role → permission mapping, scoped per org.
/// Permission catalog is defined in code (OrgPermission const); this table only
/// stores which role holds which permission within each org. Seeded with defaults
/// on org creation, then editable by the OWNER at runtime (no deploy needed).
/// OWNER has NO rows here — OrgGuard treats OWNER as holding every permission (implicit).
model OrgRolePermission {
  id         String   @id @default(uuid(7))
  orgId      String   @map("org_id")
  role       OrgRole
  permission String // matches a value in the OrgPermission catalog (e.g. "knowledge:write")
  createdAt  DateTime @default(now()) @map("created_at")

  org Organization @relation(fields: [orgId], references: [id])

  @@unique([orgId, role, permission])
  @@index([orgId, role])
  @@map("org_role_permissions")
}

model OrgInvite {
  id        String    @id @default(uuid(7))
  token     String    @unique
  orgId     String    @map("org_id")
  role      OrgRole   @default(MEMBER)
  createdBy String    @map("created_by")  // loose ref to auth_db userId
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  usedBy    String?   @map("used_by")     // userId who accepted

  org Organization @relation(fields: [orgId], references: [id])

  @@index([orgId])
  @@map("org_invites")
}

// ─────────────────────────────────────────────
// KNOWLEDGE CONTEXT — Write Model + OCC
// ─────────────────────────────────────────────

model KnowledgeItem {
  id               String          @id @default(uuid(7))
  orgId            String          @map("org_id")
  spaceId          String          @map("space_id")
  type             KnowledgeType
  title            String
  body             String          @db.Text
  parentId         String?         @map("parent_id")
  acceptedAnswerId String?         @map("accepted_answer_id")
  status           KnowledgeStatus @default(DRAFT)
  isVerified       Boolean         @default(false)   @map("is_verified")
  version          Int             @default(1)        // OCC — check before update
  contentHash      String?         @map("content_hash")
  createdByUserId  String          @map("created_by_user_id")
  updatedByUserId  String?         @map("updated_by_user_id")
  createdAt        DateTime        @default(now())    @map("created_at")
  updatedAt        DateTime        @updatedAt         @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  revisions Revision[]
  votes     Vote[]

  @@index([orgId, spaceId])
  @@index([orgId, status])
  @@map("knowledge_items")
}

enum KnowledgeType {
  DOCUMENT
  QUESTION
  ANSWER
  RUNBOOK
  ADR
}

enum KnowledgeStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  STALE
}

model Revision {
  id             String   @id @default(uuid(7))
  itemId         String   @map("item_id")
  version        Int
  bodySnapshot   String   @db.Text @map("body_snapshot")
  editedByUserId String   @map("edited_by_user_id")
  createdAt      DateTime @default(now()) @map("created_at")

  item KnowledgeItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, version])
  @@map("revisions")
}

model Tag {
  id    String @id @default(uuid(7))
  orgId String @map("org_id")
  name  String

  @@unique([orgId, name])
  @@map("tags")
}

// ─────────────────────────────────────────────
// ENGAGEMENT CONTEXT
// ─────────────────────────────────────────────

model Vote {
  id        String   @id @default(uuid(7))
  orgId     String   @map("org_id")
  itemId    String   @map("item_id")
  userId    String   @map("user_id")
  value     Int      // +1 upvote / -1 downvote
  createdAt DateTime @default(now()) @map("created_at")

  item KnowledgeItem @relation(fields: [itemId], references: [id])

  @@unique([itemId, userId])
  @@index([orgId, itemId])
  @@map("votes")
}

model Bookmark {
  id        String   @id @default(uuid(7))
  orgId     String   @map("org_id")
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, itemId])
  @@index([orgId, userId])
  @@map("bookmarks")
}

model Follow {
  id         String           @id @default(uuid(7))
  orgId      String           @map("org_id")
  userId     String           @map("user_id")
  targetType FollowTargetType @map("target_type")
  targetId   String           @map("target_id")
  createdAt  DateTime         @default(now()) @map("created_at")

  @@unique([userId, targetType, targetId])
  @@index([orgId, userId])
  @@map("follows")
}

enum FollowTargetType {
  DOCUMENT
  SPACE
}

// ─────────────────────────────────────────────
// CREDIT CONTEXT — Event Sourcing (append-only)
// ─────────────────────────────────────────────

/// Append-only credit event ledger. NEVER UPDATE or DELETE rows.
/// eventType: CreditPurchased | CreditAwarded | CreditRefunded (+)
///            CreditSpent | CreditStaked | CreditReserved (−)
model CreditEvent {
  id          String   @id @default(uuid(7))
  aggregateId String   @map("aggregate_id")   // wallet id, per-user-per-org: "${orgId}:${userId}"
  eventType   String   @map("event_type")
  version     Int                              // per-aggregate sequence for OCC
  payload     Json
  orgId       String   @map("org_id")          // denormalized from aggregateId for tenant-safe query/audit
  userId      String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([aggregateId, version])
  @@index([aggregateId])
  @@index([orgId])
  @@map("credit_events")
}

// ─────────────────────────────────────────────
// REPUTATION CONTEXT — Event Sourcing (append-only)
// ─────────────────────────────────────────────

/// Append-only reputation event ledger. NEVER UPDATE or DELETE rows.
/// eventType: PointsEarned | PointsDeducted | BadgeAwarded | BadgeRevoked
model ReputationEvent {
  id          String   @id @default(uuid(7))
  aggregateId String   @map("aggregate_id")   // userId (reputation is per user per org)
  eventType   String   @map("event_type")
  version     Int                              // per-aggregate sequence for OCC
  payload     Json
  orgId       String   @map("org_id")         // reputation is scoped per org
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([aggregateId, version])
  @@index([aggregateId])
  @@index([orgId])
  @@map("reputation_events")
}

// ─────────────────────────────────────────────
// INFRASTRUCTURE — Outbox + Idempotency
// ─────────────────────────────────────────────

/// Transactional Outbox: written atomically with domain event in same DB transaction.
model OutboxEvent {
  id            String       @id @default(uuid(7))
  aggregateType String       @map("aggregate_type")
  aggregateId   String       @map("aggregate_id")
  eventType     String       @map("event_type")
  // Denormalized from the producing command's tenant context (mirrors CreditEvent/
  // ReputationEvent) — the CloudEvents `orgid` extension is built FROM this column,
  // not dug out of `payload`. Single source of truth; payload no longer repeats it.
  orgId         String       @map("org_id")
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  createdAt     DateTime     @default(now()) @map("created_at")
  processedAt   DateTime?    @map("processed_at")
  // Set when a poller claims the row (PENDING → INFLIGHT). Lets a reaper reset
  // rows orphaned by a publisher crash between claim and publish.
  claimedAt     DateTime?    @map("claimed_at")
  // W3C traceparent of the command that produced this row (captured from the
  // trace-context ALS at append() time) — copied onto the CloudEvent's
  // `traceparent` extension at publish time so the consumer's logs correlate
  // back to this request. Null for events with no active trace context.
  traceparent   String?      @map("traceparent")

  @@index([status, createdAt])
  @@index([orgId])
  @@map("outbox_events")
}

enum OutboxStatus {
  PENDING
  INFLIGHT
  PROCESSED
  FAILED_DLQ
}

/// Idempotency key cache — prevents duplicate mutations from retried requests.
model IdempotencyRecord {
  key         String   @id               // X-Idempotency-Key header value
  // sha256(method + url + body) claimed under this key — detects the real
  // Stripe-style hazard of a client reusing the same key for a genuinely
  // different request (bug, or copy-pasted key), which must be rejected
  // rather than silently replaying the wrong cached response.
  requestHash String   @map("request_hash")
  // NULL = key claimed, handler still running (concurrent-request guard —
  // resilience_patterns.md §1.1). Filled in once the handler completes.
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_records")
}
